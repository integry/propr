<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="8F69D07A-E7CB-46DB-96B2-C6557B83D110" Name="ProPR Connect Authority" Language="1033" Version="3.0.0.0"
           Manufacturer="ProPR" UpgradeCode="3B67D694-7F5A-4D92-932A-1CD8CF3D4F79">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" InstallPrivileges="elevated" />
    <MajorUpgrade DowngradeErrorMessage="A newer ProPR Connect Authority is already installed. Repair or upgrade the CLI." />
    <MediaTemplate EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="ProPR Connect Authority">
          <Component Id="AuthorityService" Guid="D8585B64-5B93-4577-A340-1567A0F116B1" Win64="yes">
            <CreateFolder>
              <Permission User="SYSTEM" GenericAll="yes" />
              <Permission Domain="NT SERVICE" User="TrustedInstaller" GenericAll="yes" />
              <Permission User="Authenticated Users" Read="yes" Execute="yes" Traverse="yes" />
            </CreateFolder>
            <File Id="AuthorityServiceFile" Source="$(var.AuthorityServicePath)" KeyPath="yes" Checksum="yes" Vital="yes">
              <Permission User="SYSTEM" GenericAll="yes" />
              <Permission Domain="NT SERVICE" User="TrustedInstaller" GenericAll="yes" />
              <Permission User="Authenticated Users" Read="yes" Execute="yes" />
            </File>
            <ServiceInstall Id="InstallAuthority" Name="ProPRConnectAuthority" DisplayName="ProPR Connect Authority"
              Description="Machine trust anchor for bounded ProPR Connect native launches" Type="ownProcess"
              Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
              <ServiceConfig Id="AuthorityServiceSid" ServiceSid="unrestricted"
                OnInstall="yes" OnReinstall="yes" OnUninstall="no" />
            </ServiceInstall>
            <ServiceControl Id="ControlAuthority" Name="ProPRConnectAuthority" Start="install" Stop="both"
              Remove="uninstall" Wait="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="AuthorityFeature" Title="ProPR Connect Authority" Level="1">
      <ComponentRef Id="AuthorityService" />
    </Feature>
  </Product>
</Wix>
