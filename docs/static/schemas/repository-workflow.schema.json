{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.propr.dev/schemas/repository-workflow.schema.json",
  "title": "ProPR repository workflow",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after_create": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
        },
        "before_run": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
        },
        "after_run": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
        },
        "before_remove": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Per-command timeout, capped at 600000 ms."
        }
      }
    },
    "instructions": {
      "allOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
        },
        {
          "pattern": "^(?=[\\s\\S]*\\S)(?!/)(?![\\s\\S]*\\\\)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*/$)[^\\u0000]+$"
        }
      ]
    },
    "validation": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
      }
    },
    "previews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "image",
              "video"
            ]
          }
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Repository-wide execution cap, bounded by instance worker_concurrency."
        }
      }
    },
    "auto_merge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Policy for when ProPR may arm GitHub auto-merge. Read from the PR's base branch; .propr/** is always protected.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "false never arms auto-merge, even when the auto-merge label is present."
        },
        "method": {
          "enum": [
            "merge",
            "squash",
            "rebase"
          ],
          "description": "Merge method; defaults to the repository default (squash unless the repository disallows it)."
        },
        "protected_paths": {
          "type": "array",
          "maxItems": 200,
          "description": "Repository-root-anchored globs (*, ?, **, [...]); any changed path that matches keeps auto-merge disarmed. Case-insensitive; a matching directory protects its contents.",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=[\\s\\S]*\\S)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          }
        }
      }
    }
  }
}
